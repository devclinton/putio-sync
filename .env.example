# Put.io OAuth Application Configuration
#
# To use the OAuth flow, you need to register an OAuth application at Put.io
# Then copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control (it's in .gitignore)

# Your Put.io OAuth Client ID
PUTIO_CLIENT_ID=your_client_id_here

# Your Put.io OAuth Client Secret
PUTIO_CLIENT_SECRET=your_client_secret_here

# OAuth Redirect URI (must match what you registered)
# Default: http://localhost:29876/auth/callback
PUTIO_REDIRECT_URI=http://localhost:29876/auth/callback
