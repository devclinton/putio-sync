# syntax=docker/dockerfile:1
#
# putio-sync on Docker Hardened Images (dhi.io), feature 053. Pick a stage with
# --target; each one is published under its own tag prefix:
#
#   binary          the static musl binary alone (release assets, not an image);
#                   --build-arg PUTIO_SYNC_EDITION=lite or lite-plugins for
#                   the CLI-only builds
#   runtime         dhi.io/static: no shell, no package manager      :dhi-<ver>
#   runtime-ffmpeg  runtime plus static ffmpeg/ffprobe for subtitles :dhi-ffmpeg-<ver>
#   dev             dhi.io/alpine-base -dev: shell and apk           :dev-<ver>
#   dev-ffmpeg      dev plus the same static ffmpeg/ffprobe          :dev-ffmpeg-<ver>
#
# The plain Dockerfile (alpine, ffmpeg from apk) stays the :main/:<ver> image.
# Pulling dhi.io needs `docker login dhi.io` with a Docker account.

# DHI has no ffmpeg image, so the -ffmpeg stages copy a static build (musl,
# amd64 and arm64) that runs without a libc.
ARG FFMPEG_IMAGE=mwader/static-ffmpeg:8.0.1
# The update checker names the right docker pull from this and each stage's variant (055)
ARG PUTIO_SYNC_IMAGE=ghcr.io/devclinton/putio-sync

FROM dhi.io/rust:1.96-alpine3.22-dev AS builder
WORKDIR /build
COPY . .

# Commit SHA for putio_sync_build_info (read by option_env! at compile time)
ARG PUTIO_SYNC_GIT_SHA=unknown
ENV PUTIO_SYNC_GIT_SHA=$PUTIO_SYNC_GIT_SHA

# full, or a CLI-only build without the daemon, API and web UI (binary stage
# only; the images run the daemon): lite has event hooks, lite-plugins hooks
# and plugins
ARG PUTIO_SYNC_EDITION=full

# The *-linux-musl host target links statically by default: SQLite, Lua and
# ring compile from vendored C, and TLS is rustls, so nothing is left to link.
ARG TARGETARCH
RUN --mount=type=cache,id=putio-sync-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=putio-sync-target-${TARGETARCH}-${PUTIO_SYNC_EDITION},target=/build/target \
    case "$PUTIO_SYNC_EDITION" in \
        lite) cargo build --release --locked -p putio-sync-cli --no-default-features --features hooks ;; \
        lite-plugins) cargo build --release --locked -p putio-sync-cli --no-default-features --features hooks,plugins ;; \
        full) cargo build --release --locked --bin putio-sync ;; \
        *) echo "Unknown PUTIO_SYNC_EDITION: $PUTIO_SYNC_EDITION"; exit 1 ;; \
    esac && \
    cp target/release/putio-sync /putio-sync && \
    if readelf -d /putio-sync | grep -q NEEDED; then \
        echo "putio-sync is dynamically linked:"; readelf -d /putio-sync | grep NEEDED; exit 1; \
    fi && \
    mkdir -p /rootfs/config /rootfs/downloads /rootfs/watches

FROM scratch AS binary
COPY --from=builder /putio-sync /putio-sync

FROM ${FFMPEG_IMAGE} AS ffmpeg

FROM dhi.io/alpine-base:3.22-dev AS dev
# The static base ships time zones; this one doesn't (bandwidth schedules use them)
RUN apk add --no-cache tzdata
COPY --from=builder --chown=99:100 /rootfs/ /
COPY --from=builder /putio-sync /usr/local/bin/putio-sync
COPY CHANGELOG.md /usr/share/doc/putio-sync/CHANGELOG.md
# Same user as the alpine image (Unraid's nobody:users); override with --user
USER 99:100
ENV HOME=/config RUST_LOG=info
ARG PUTIO_SYNC_IMAGE
ENV PUTIO_SYNC_IMAGE=$PUTIO_SYNC_IMAGE PUTIO_SYNC_IMAGE_VARIANT=dev
VOLUME ["/config", "/downloads", "/watches"]
WORKDIR /config
EXPOSE 9742 15432
CMD ["putio-sync", "--config", "/config/config.toml", "daemon", "--download-interval", "60", "--watch-interval", "60"]

FROM dev AS dev-ffmpeg
COPY --from=ffmpeg /ffmpeg /ffprobe /usr/local/bin/
ENV PUTIO_SYNC_IMAGE_VARIANT=dev-ffmpeg

FROM dhi.io/static:20250419-debian13 AS runtime
COPY --from=builder --chown=99:100 /rootfs/ /
COPY --from=builder /putio-sync /usr/local/bin/putio-sync
COPY CHANGELOG.md /usr/share/doc/putio-sync/CHANGELOG.md
USER 99:100
ENV HOME=/config RUST_LOG=info
ARG PUTIO_SYNC_IMAGE
ENV PUTIO_SYNC_IMAGE=$PUTIO_SYNC_IMAGE PUTIO_SYNC_IMAGE_VARIANT=dhi
VOLUME ["/config", "/downloads", "/watches"]
WORKDIR /config
EXPOSE 9742 15432
CMD ["putio-sync", "--config", "/config/config.toml", "daemon", "--download-interval", "60", "--watch-interval", "60"]

FROM runtime AS runtime-ffmpeg
COPY --from=ffmpeg /ffmpeg /ffprobe /usr/local/bin/
ENV PUTIO_SYNC_IMAGE_VARIANT=dhi-ffmpeg
